{
  "name": "selld",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.19"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "supabase"
    ]
  },
  "scripts": {
    "dev": "vite",
    "dev:store": "tsx --tsconfig tsconfig.server.json --env-file-if-exists=.env.local server/storefront-server.ts",
    "build": "tsc -b && pnpm build:client && pnpm build:server && pnpm build:api",
    "preview": "pnpm build && pnpm start",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase migration up",
    "db:new": "supabase migration new",
    "db:types": "supabase gen types typescript --local > /tmp/selld-types.ts && printf '%s\\n' '/**' ' * Generated Supabase types — DO NOT EDIT BY HAND.' ' *' ' * Regenerate after every migration:' ' *   pnpm db:types' ' *' ' * Checked in so CI can typecheck without a running database.' ' */' '' > src/lib/supabase/database.types.ts && cat /tmp/selld-types.ts >> src/lib/supabase/database.types.ts",
    "db:test": "tsx scripts/db-test.ts",
    "db:test:concurrency": "tsx scripts/db-concurrency-test.ts",
    "psgc:build": "tsx scripts/psgc-build.ts",
    "pwa:icons": "tsx scripts/pwa-icons.ts",
    "load:test": "tsx --env-file-if-exists=.env.local scripts/load-test.ts",
    "psgc:seed": "tsx scripts/psgc-seed.ts",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/storefront/entry-server.tsx",
    "start": "NODE_ENV=production tsx --tsconfig tsconfig.server.json --env-file-if-exists=.env.local server/storefront-server.ts",
    "seed:demo": "tsx --env-file-if-exists=.env.local scripts/seed-demo.ts",
    "lighthouse": "tsx --env-file-if-exists=.env.local scripts/lighthouse-check.ts",
    "build:api": "esbuild server/vercel-entry.ts --bundle --platform=node --format=esm --target=node22 --tsconfig=tsconfig.server.json --external:vite --external:lightningcss --outfile=dist/api/handler.js"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/supabase-js": "^2.111.0",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.6",
    "lucide-react": "^0.552.0",
    "pdf-lib": "^1.17.1",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.1",
    "@types/pg": "^8.15.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.4",
    "esbuild": "0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^28.0.2",
    "jsqr": "^1.4.0",
    "lighthouse": "^13.4.1",
    "pg": "^8.22.0",
    "playwright": "1.56.0",
    "supabase": "^2.110.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
