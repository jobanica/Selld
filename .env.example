# Selld — copy to `.env.local` and fill in. Never commit real values.
#
# Anything prefixed VITE_ is embedded in the client bundle and is PUBLIC.
# Secrets (service role key, provider API keys) belong in Supabase Edge Function
# secrets or Vercel server-side env vars — never in a VITE_ var.

# ---------------------------------------------------------------------------
# Supabase (public — safe to expose, protected by RLS)
# ---------------------------------------------------------------------------
# `supabase start` prints these for local dev.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Root domain for storefront subdomains: {slug}.selld.ph
VITE_APP_ROOT_DOMAIN=selld.ph
VITE_APP_ENV=development

# ---------------------------------------------------------------------------
# Server-side only — used by scripts and Edge Functions, NOT the browser
# ---------------------------------------------------------------------------
# Direct Postgres connection, used by `pnpm psgc:seed`.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_SERVICE_ROLE_KEY=

# Providers (phase 8+). Listed here so the shape is known; unused in phase 0.
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
JNT_API_KEY=
JNT_CUSTOMER_CODE=
FLASH_API_KEY=
FLASH_MERCHANT_ID=
FB_APP_ID=
FB_APP_SECRET=
FB_WEBHOOK_VERIFY_TOKEN=

# Key for encrypting courier API credentials at rest (phase 10).
# Held here rather than in Postgres on purpose: a stolen database dump is then
# useless on its own. Generate with: openssl rand -base64 32
COURIER_CREDENTIALS_KEY=

# The unguessable path segment on the inbound courier tracking webhook (phase 11):
#   POST /api/webhooks/courier/{courier}/{COURIER_WEBHOOK_SECRET}
# Neither J&T nor Flash signs its tracking pushes, so the URL is the credential.
# Unset means the endpoint answers 503 and tracking falls back to polling.
# Generate with: openssl rand -hex 24
COURIER_WEBHOOK_SECRET=

# The unguessable path segment on the inbound live-comment webhook (phase 13):
#   POST /api/webhooks/live/{channel}/{LIVE_WEBHOOK_SECRET}
# When FB_APP_SECRET is also set, X-Hub-Signature-256 is verified as well; without
# an app secret this path segment is the only thing between a stranger and a
# seller's stock. Unset means the endpoint answers 503.
# Generate with: openssl rand -hex 24
LIVE_WEBHOOK_SECRET=

# The unguessable path segment on the inbound page webhook (phase 14):
#   POST /api/webhooks/social/{SOCIAL_WEBHOOK_SECRET}
# Comments on posts and Messenger DMs both arrive here. Same rule as the live
# webhook: with FB_APP_SECRET set, X-Hub-Signature-256 is verified too.
# Generate with: openssl rand -hex 24
SOCIAL_WEBHOOK_SECRET=

# Key for encrypting page access tokens at rest (phase 14). Falls back to
# COURIER_CREDENTIALS_KEY when unset, but give it its own: a page token can post
# as the seller, read their inbox and message their customers, which is a much
# larger blast radius than a courier API key.
# Generate with: openssl rand -base64 32
SOCIAL_TOKEN_KEY=

# Where the OAuth callback lives, if the server is behind a proxy that rewrites
# the host. Facebook compares the redirect_uri byte for byte against the one
# registered in the app, so it cannot be derived from the request.
#   SELLD_PUBLIC_URL=https://app.selld.ph
SELLD_PUBLIC_URL=

# Points the Graph client somewhere else. Only for tests and local fakes — unset
# in every real deployment.
FB_GRAPH_BASE_URL=

# ---------------------------------------------------------------------------
# Platform billing (phase 19)
# ---------------------------------------------------------------------------
# Selld's OWN Xendit account — the one sellers pay *us* through. Not a seller's:
# their buyers pay them through `payment_accounts`, which is phase 8 and separate.
# Never VITE_-prefixed; this key can charge cards, and a VITE_ variable is
# compiled into the public bundle. With either of these unset the biller simply
# does not start, so a developer looking at a product page needs neither.
PLATFORM_XENDIT_SECRET_KEY=
PLATFORM_XENDIT_CALLBACK_TOKEN=

# Where a seller lands after paying a subscription invoice or a credit pack.
PLATFORM_BILLING_RETURN_URL=

# Points the biller at a fake gateway. Only for tests and local end-to-end runs —
# unset in every real deployment, where the default is the only address there is.
PLATFORM_XENDIT_API_BASE=

# ---------------------------------------------------------------------------
# Error tracking (phase 20)
# ---------------------------------------------------------------------------
# A Sentry DSN. Public by design — it identifies the project and authorises
# writes only — so the browser's copy is VITE_-prefixed on purpose. Unset
# disables reporting entirely.
#
# What leaves the process goes through src/lib/telemetry/scrub.ts first. Read
# the note at the top of report-error.ts before replacing this with the vendor
# SDK: its defaults send the URL, the headers, the cookies and the breadcrumb
# trail, and on this platform every one of those carries a buyer's phone number.
VITE_SENTRY_DSN=
SENTRY_DSN=
